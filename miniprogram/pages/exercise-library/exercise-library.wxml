<view class="page">
  <!-- 搜索 -->
  <view class="search-row">
    <input class="input flex-1" placeholder="搜索动作（中文/英文）" placeholder-class="input-placeholder"
           value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <view class="btn btn-primary btn-sm" bindtap="onSearch">搜索</view>
  </view>

  <!-- 肌群分组 -->
  <scroll-view scroll-x class="group-scroll" wx:if="{{groups.length > 0}}">
    <view class="group-row">
      <view class="gchip {{activeGroup === '' ? 'gchip-active' : ''}}" data-key="" bindtap="onSelectGroup">全部</view>
      <view wx:for="{{groups}}" wx:key="key"
            class="gchip {{activeGroup === item.key ? 'gchip-active' : ''}}"
            data-key="{{item.key}}" bindtap="onSelectGroup">{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view wx:if="{{loading}}" class="loading-wrap">加载中...</view>
  <view wx:elif="{{exercises.length === 0}}" class="empty-wrap">
    <text class="empty-icon"></text>
    <text>没有找到动作</text>
  </view>

  <view wx:for="{{exercises}}" wx:key="exercise_id" class="card ex-card" data-index="{{index}}" bindtap="onPickToggle">
    <view class="ex-row">
      <view class="ex-thumb">
        <image wx:if="{{item.gif_full}}" src="{{item.gif_full}}" mode="aspectFill" class="ex-thumb-img" lazy-load />
        <text wx:else class="ex-thumb-placeholder"></text>
      </view>
      <view class="ex-info">
        <view class="ex-title">
          <text class="ex-name">{{item.name_zh || item.name}}</text>
          <text wx:if="{{item.is_private}}" class="badge badge-accent">我的</text>
        </view>
        <view class="ex-meta">{{item.target_muscle || '—'}} · {{item.equipment || '徒手'}} · {{item.category || ''}}</view>
      </view>
      <view wx:if="{{mode === 'picker'}}" class="pick-box {{item.is_picked ? 'pick-box-active' : ''}}">
        {{item.is_picked ? '✓' : '+'}}
      </view>
      <text wx:else class="arrow">›</text>
    </view>
  </view>

  <!-- picker 模式底部确认 -->
  <view wx:if="{{mode === 'picker'}}" class="bottom-bar safe-bottom">
    <view class="btn btn-primary" bindtap="onConfirmPick">确认选择（{{picked.length}}）</view>
  </view>
</view>
