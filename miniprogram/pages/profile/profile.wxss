.user-card {
  display: flex;
  align-items: center;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FF4D2E;
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 24rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #F2F4F5;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-meta {
  font-size: 24rpx;
  color: #5C6570;
  margin-top: 8rpx;
}

.user-id {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9BA3AD;
}

.user-id-copy {
  color: #FF4D2E;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border: 1rpx solid #FF4D2E;
  border-radius: 8rpx;
}

.edit-btn {
  font-size: 24rpx;
  color: #FF4D2E;
  border: 1rpx solid #FF4D2E;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
}

.energy-row {
  display: flex;
  gap: 12rpx;
}

.energy-item {
  flex: 1;
  background: #1A1D22;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.energy-value {
  font-size: 34rpx;
  font-weight: 700;
}

.energy-label {
  font-size: 22rpx;
  color: #5C6570;
  margin-top: 6rpx;
}

.menu-card {
  padding: 8rpx 28rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #262A31;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #F2F4F5;
}

.menu-arrow {
  color: #5C6570;
  font-size: 32rpx;
}

.footer-tip {
  text-align: center;
  color: #5B6B82;
  font-size: 22rpx;
  padding: 32rpx 0;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  /* 自定义 tabBar 也是 z-index 999 且后于页面渲染，同级会把弹窗底部（保存/取消按钮）盖住，
     导致按钮点不到。这里抬高一层并避开 tabBar 高度。 */
  z-index: 1000;
  padding-bottom: calc(var(--tabbar-height, 112rpx) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.modal {
  width: 640rpx;
  /* 减去 tabBar 高度与安全区，保证弹窗整体落在 tabBar 上方 */
  max-height: calc(100vh - var(--tabbar-height, 112rpx) - env(safe-area-inset-bottom) - 64rpx);
  display: flex;
  flex-direction: column;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 24rpx;
  padding: 32rpx;
}

.modal-title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #F2F4F5;
  margin-bottom: 24rpx;
}

.form {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.gender-row {
  display: flex;
  gap: 16rpx;
}

.gchip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #1A1D22;
  border: 1rpx solid #262A31;
  font-size: 26rpx;
  color: #9BA3AD;
}

.gchip-active {
  background: rgba(14, 165, 233, 0.15);
  border-color: #FF4D2E;
  color: #FF4D2E;
  font-weight: 600;
}

.row-inputs {
  display: flex;
  gap: 16rpx;
}

.picker-input {
  color: #9BA3AD;
}

.goal-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.goal-wrap .gchip {
  flex: none;
  padding: 12rpx 28rpx;
}

.modal-btns {
  flex-shrink: 0;
  margin-top: 16rpx;
  gap: 16rpx;
}
