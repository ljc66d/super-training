.about-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx;
}

.about-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FF4D2E, #D93A1E);
  color: #fff;
  font-size: 60rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.about-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #F2F4F5;
}

.about-ver {
  font-size: 22rpx;
  color: #5C6570;
  margin-top: 8rpx;
}

.about-desc {
  font-size: 24rpx;
  color: #9BA3AD;
  text-align: center;
  margin-top: 16rpx;
  line-height: 1.6;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #262A31;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #F2F4F5;
}

.menu-value {
  font-size: 22rpx;
  color: #5C6570;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tip-card {
  background: rgba(245, 158, 11, 0.08);
  border: 1rpx solid rgba(245, 158, 11, 0.3);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #E8A33D;
  display: block;
  margin-bottom: 12rpx;
}

.tip-text {
  font-size: 22rpx;
  color: #9BA3AD;
  display: block;
  line-height: 1.7;
}

.footer-tip {
  text-align: center;
  color: #5B6B82;
  font-size: 22rpx;
  padding: 24rpx 0;
}
