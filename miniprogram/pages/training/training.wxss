/* 训练页：整页是一个 scroll-view，高度需减去自定义 tabBar。
   底部留白放在内层 .training-inner 上——scroll-view 自身的 padding-bottom
   在部分机型（尤其 iOS）不会被算进可滚动内容高度，放内部 view 才可靠。
   尺寸统一引用 app.wxss 里定义的 CSS 变量。 */
.training-page {
  height: calc(100vh - var(--tabbar-height) - env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.training-inner {
  padding-bottom: var(--tabbar-clearance);
}

/* 顶部标题 */
.training-header {
  padding: 24rpx 8rpx 16rpx;
}

.training-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #F2F4F5;
}

.training-sub {
  display: block;
  font-size: 24rpx;
  color: #5C6570;
  margin-top: 8rpx;
}

/* 运动大类 3 列网格 */
.cat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.cat-card {
  box-sizing: border-box;
  padding: 32rpx 8rpx;
  border-radius: 16rpx;
  background: #1A1D22;
  border: 1rpx solid #262A31;
  text-align: center;
}

.cat-card.active {
  background: #FF4D2E;
  border-color: #FF4D2E;
}

.cat-card-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.cat-card.active .cat-card-text {
  color: #fff;
}

.timer-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 28rpx;
}

.timer-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #F2F4F5;
  font-variant-numeric: tabular-nums;
  letter-spacing: 4rpx;
  margin-bottom: 32rpx;
}

.timer-running {
  color: #3ECF8E;
}

.btn-timer {
  width: 100%;
}

.training-start-btn-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  /* 贴在 tabBar 上方，留 --tabbar-gap 的间隙 */
  bottom: calc(var(--tabbar-height) + var(--tabbar-gap) + env(safe-area-inset-bottom));
  z-index: 100;
}

.training-start-btn-wrap .btn-timer {
  margin-bottom: 0;
}

.stats-badges {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  margin: 12rpx 0;
}

.add-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin: 12rpx 0;
}

.ex-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.ex-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.ex-remove {
  color: #5C6570;
  font-size: 30rpx;
  padding: 4rpx 12rpx;
}

.set-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.set-no {
  width: 96rpx;
  font-size: 24rpx;
  color: #5C6570;
}

.set-input {
  flex: 1;
  height: 72rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  text-align: center;
}

.set-input-rpe {
  flex: 0 0 104rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
}

.set-done {
  width: 104rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #1A1D22;
  border: 1rpx solid #262A31;
  color: #9BA3AD;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.set-done-active {
  background: #3ECF8E;
  border-color: #3ECF8E;
  color: #fff;
  font-weight: 700;
}

.add-set {
  text-align: center;
  color: #FF4D2E;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-top: 1rpx dashed #262A31;
  margin-top: 8rpx;
}

.custom-sport-tip {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  background: rgba(255, 77, 46, 0.1);
  border: 1rpx solid rgba(255, 77, 46, 0.3);
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #9BA3AD;
}

.custom-sport-name {
  color: #FF4D2E;
  font-weight: 600;
}

.custom-sport-panel {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.custom-sport-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.custom-chip {
  background: #1A1D22;
  border: 1rpx solid #262A31;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #F2F4F5;
  font-weight: 600;
}

.custom-chip-active {
  background: #FF4D2E;
  border-color: #FF4D2E;
  color: #fff;
}

.custom-sport-add {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

/* 耐力分组 */
.run-group-tip {
  font-size: 24rpx;
  color: #5C6570;
  margin-bottom: 16rpx;
}

.hr-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.run-group {
  background: #1A1D22;
  border: 1rpx solid #262A31;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.run-group-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.run-group-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.run-group-del {
  font-size: 24rpx;
  color: #E5484D;
}

.run-group-inputs {
  display: flex;
  gap: 12rpx;
}

.add-btn {
  margin-top: 8rpx;
}

/* 耐力模式切换 */
.run-mode-switch {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.run-mode-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #9BA3AD;
  background: #1A1D22;
  border: 1rpx solid #262A31;
  border-radius: 12rpx;
}

.run-mode-item.active {
  background: #FF4D2E;
  border-color: #FF4D2E;
  color: #fff;
}

/* CrossFit WOD 动作 */
.wod-mov {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  background: #1A1D22;
  border: 1rpx solid #262A31;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.wod-mov-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.pick-lib {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #FF4D2E;
  border: 1rpx solid #FF4D2E;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
}

/* Hyrox 分段 */
.hyrox-station {
  background: #1A1D22;
  border: 1rpx solid #262A31;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.hyrox-station-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.hyrox-station-no {
  font-size: 26rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.hyrox-station-done {
  font-size: 24rpx;
  color: #9BA3AD;
  padding: 6rpx 16rpx;
  border: 1rpx solid #262A31;
  border-radius: 8rpx;
}

.hyrox-station-done.done {
  color: #3ECF8E;
  border-color: #3ECF8E;
  background: rgba(62, 207, 142, 0.1);
}

.hr-row-label {
  font-size: 22rpx;
  color: #5C6570;
  margin-bottom: 8rpx;
}
