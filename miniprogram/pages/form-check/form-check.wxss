.tab-row {
  display: flex;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #9BA3AD;
  padding: 16rpx 0;
  border-radius: 14rpx;
}

.tab-active {
  background: #FF4D2E;
  color: #fff;
  font-weight: 600;
}

.intro-text {
  font-size: 26rpx;
  color: #9BA3AD;
  line-height: 1.7;
}

.intro-btn {
  margin-top: 24rpx;
}

.action-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.action-desc {
  font-size: 24rpx;
  color: #5C6570;
  display: block;
  margin-top: 10rpx;
}

.score-wrap {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 64rpx;
  font-weight: 700;
}

.score-den {
  font-size: 26rpx;
  color: #5C6570;
  margin-left: 6rpx;
}

.record-time {
  font-size: 22rpx;
  color: #5C6570;
}

.rec-level {
  margin-top: 12rpx;
}

.corr-item {
  font-size: 24rpx;
  color: #9BA3AD;
  padding: 6rpx 0;
  line-height: 1.6;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 620rpx;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 24rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #F2F4F5;
}

.modal-sub {
  font-size: 24rpx;
  color: #FF4D2E;
  margin: 8rpx 0 16rpx;
}

.modal-text {
  font-size: 26rpx;
  color: #9BA3AD;
  line-height: 1.7;
}

.modal-btn {
  margin-top: 32rpx;
}
