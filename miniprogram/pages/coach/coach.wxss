.coach-intro {
  padding: 120rpx 40rpx;
}

.intro-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #F2F4F5;
  margin-top: 12rpx;
}

.intro-sub {
  font-size: 24rpx;
  color: #5C6570;
  text-align: center;
  line-height: 1.7;
  margin-top: 12rpx;
}

.intro-btn {
  margin-top: 40rpx;
  width: 400rpx;
}

.tab-row {
  display: flex;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #9BA3AD;
  padding: 16rpx 0;
  border-radius: 14rpx;
}

.tab-active {
  background: #FF4D2E;
  color: #fff;
  font-weight: 600;
}

.add-btn-row {
  margin-bottom: 24rpx;
}

.student-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #F2F4F5;
}

.student-note {
  font-size: 22rpx;
  color: #5C6570;
  margin-left: 16rpx;
}

.sum-row {
  display: flex;
  gap: 12rpx;
}

.sum-item {
  flex: 1;
  background: #1A1D22;
  border-radius: 16rpx;
  padding: 20rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-value {
  font-size: 32rpx;
  font-weight: 700;
}

.sum-label {
  font-size: 20rpx;
  color: #5C6570;
  margin-top: 6rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal {
  width: 620rpx;
  background: #14161A;
  border: 1rpx solid #262A31;
  border-radius: 24rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F2F4F5;
  margin-bottom: 24rpx;
}

.modal-gap {
  margin-top: 20rpx;
}

.modal-btns {
  margin-top: 32rpx;
  gap: 16rpx;
}
