# 「超会练」后端环境变量模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，不会上传

DATABASE_URL=sqlite:///./super_training.db

# 小程序鉴权（微信公众平台 → 开发管理 → 开发设置）
WX_APPID=your_appid_here
WX_SECRET=your_secret_here

# JWT 签名密钥（ openssl rand -hex 32 生成）
JWT_SECRET=change_me_to_a_random_string

# 大模型服务（OpenAI 兼容接口，用于自然语言录入解析与建议生成）
LLM_BASE_URL=https://your-llm-provider/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name

# 视觉理解服务（用于食物图片识别）
VISION_BASE_URL=https://your-vision-provider/v1
VISION_API_KEY=your_vision_api_key
VISION_MODEL=your_vision_model
